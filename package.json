{
  "name": "dupecleaner",
  "version": "2.0.0",
  "private": true,
  "description": "Buscador de archivos duplicados que funciona 100% en el navegador",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "lint": "eslint . && stylelint \"**/*.css\" --ignore-pattern \"vendor/**\" --ignore-pattern \"node_modules/**\" --ignore-pattern \"playwright-report/**\"",
    "vendor": "node scripts/vendor.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "playwright test --project=chromium",
    "test:perf": "playwright test --project=perf"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@fontsource/fira-code": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fortawesome/fontawesome-free": "6.7.2",
    "@playwright/test": "1.56.1",
    "eslint": "9.39.5",
    "globals": "17.12.0",
    "stylelint": "17.15.0",
    "stylelint-config-recommended": "18.0.0"
  },
  "dependencies": {
    "hash-wasm": "4.12.0"
  }
}
